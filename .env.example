# Copy to .env and export these (or set them in your host's dashboard)
PORT=3000
NODE_ENV=production            # hides dev OTP codes, forces Secure cookies + HSTS
TRUST_PROXY=1                  # set when behind nginx/Caddy/Fly/Railway so rate limits see real IPs
APP_SECRET=change-me-long-random   # signs OTP hashes; generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-too          # enables /api/admin/*; leave unset to disable admin

# Persistent storage (mount a volume here in production)
DB_PATH=/data/soko.db
UPLOAD_DIR=/data/uploads

# SMS: "console" prints codes to the log (dev only). For real SMS use Africa's Talking:
SMS_PROVIDER=africastalking
AT_USERNAME=your-username          # "sandbox" for testing
AT_API_KEY=your-api-key
AT_SENDER_ID=                      # optional approved sender ID

# SEED=1 inserts demo listings when the database is empty (do NOT use in production)
